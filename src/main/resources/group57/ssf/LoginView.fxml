         </font>
      </Label>
      <PasswordField fx:id="LoginPassword" layoutX="104.0" layoutY="246.0" prefHeight="35.0" prefWidth="191.0" promptText="Password" />
      <Label fx:id="LoginReportText" layoutX="97.0" layoutY="337.0" prefHeight="18.0" prefWidth="191.0" wrapText="true" />
   </children>
